{
  "compilerOptions": {
    "outDir": "web/dist",
    "rootDir": "web/src",
    "strict": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["web/src/**/*.ts"]
}
