{
  "name": "polystory",
  "version": "0.1.0",
  "description": "Model 3D assets as code with Blender and an AI coding agent: one Python recipe per model, built headless into a GLB, checked against your project's budgets and palette, rendered for review. A Claude Code plugin and an Agent Skill, with a CLI any agent can call.",
  "keywords": [
    "3d",
    "3d-modeling",
    "blender",
    "gltf",
    "glb",
    "low-poly",
    "game-assets",
    "game-dev",
    "procedural-modeling",
    "threejs",
    "react-three-fiber",
    "claude-code",
    "claude-code-plugin",
    "agent-skills",
    "skill",
    "ai-coding-agent",
    "codex",
    "cursor"
  ],
  "license": "MIT",
  "author": { "name": "typeWolffo" },
  "homepage": "https://github.com/typeWolffo/polystory#readme",
  "repository": { "type": "git", "url": "git+https://github.com/typeWolffo/polystory.git" },
  "bugs": { "url": "https://github.com/typeWolffo/polystory/issues" },
  "type": "module",
  "bin": { "polystory": "scripts/polystory.mjs" },
  "files": [
    "scripts/",
    "templates/",
    "skills/",
    "hooks/",
    ".claude-plugin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "polystory": "node scripts/polystory.mjs"
  },
  "engines": { "node": ">=20" }
}
