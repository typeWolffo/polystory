{
  "name": "polystory",
  "version": "0.2.0",
  "description": "Model 3D game assets as code with three.js and an AI coding agent: one TypeScript recipe per model, built in node into a GLB, checked against your project's budgets and palette, rendered in a headless browser and reviewed with pins in yours. A Claude Code plugin and an Agent Skill, with a CLI any agent can call. Blender optional.",
  "keywords": [
    "3d",
    "3d-modeling",
    "threejs",
    "three.js",
    "gltf",
    "glb",
    "low-poly",
    "game-assets",
    "game-dev",
    "procedural-modeling",
    "react-three-fiber",
    "godot",
    "unity",
    "unreal",
    "blender",
    "claude-code",
    "claude-code-plugin",
    "agent-skills",
    "skill",
    "ai-coding-agent",
    "codex",
    "cursor"
  ],
  "license": "MIT",
  "author": {
    "name": "typeWolffo"
  },
  "homepage": "https://github.com/typeWolffo/polystory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typeWolffo/polystory.git"
  },
  "bugs": {
    "url": "https://github.com/typeWolffo/polystory/issues"
  },
  "type": "module",
  "bin": {
    "polystory": "dist/scripts/polystory.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "web/preview.html",
    "web/review.html",
    "web/dist/",
    "skills/",
    "hooks/",
    ".claude-plugin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.web.json",
    "build:web": "tsc -p tsconfig.web.json",
    "check-types": "tsc -p tsconfig.json && tsc -p tsconfig.web.json --noEmit",
    "test": "node --test",
    "prepublishOnly": "npm test",
    "polystory": "node scripts/polystory.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "playwright-core": "1.49.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/three": "0.170.0",
    "typescript": "5.7.2"
  },
  "exports": {
    ".": {
      "types": "./scripts/kit/index.ts",
      "default": "./dist/scripts/kit/index.js"
    }
  }
}
